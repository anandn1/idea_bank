#!/usr/bin/env python3
"""idea-bank-v2 capture/query CLI.

Talks directly to the SQLite database via Python's sqlite3 module, so it
works whether or not the Flask server (or GUI) is running. Built to be used
by a human at a keyboard *and* by an AI agent scripting against it:

  - every subcommand takes --json for machine-readable output
  - exit codes are meaningful: 0 success, 1 "did what you asked, but the
    target didn't exist / was rejected", 2 bad arguments (argparse default)
  - `idea --help` and `idea <subcommand> --help` are self-documenting

Run `idea --help` to see all subcommands.
"""
import argparse
import json
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

import dbutil  # noqa: E402

STATUS_FLAGS = {
    "active": ("-a", "--active"),
    "queued": ("-q", "--queued"),
    "horizon": ("-H", "--horizon"),
    "frontier": ("-f", "--frontier"),
    "archive": ("-x", "--archive"),
}

STATUS_DESCRIPTIONS = {
    "inbox": "just captured, not yet sorted (default for new ideas)",
    "active": "currently being worked on",
    "queued": "worth doing, not now -- auto-moves to archive after 8 weeks untouched",
    "horizon": "medium-term / someday, reviewed quarterly",
    "frontier": "very long-term -- a moonshot or a dream, no review cadence",
    "archive": "done, shelved, or expired",
}


def add_status_flags(parser: argparse.ArgumentParser, help_verb: str, dest: str = "status") -> None:
    """Add -a/-q/-H/-x plus --status as a mutually exclusive group."""
    group = parser.add_mutually_exclusive_group()
    for status, flags in STATUS_FLAGS.items():
        group.add_argument(
            *flags, dest=dest, action="store_const", const=status,
            help=f"{help_verb} {status} ({STATUS_DESCRIPTIONS[status]})",
        )
    group.add_argument(
        "--status", dest=dest, choices=dbutil.STATUSES,
        help=f"{help_verb} the given status (alternative to -a/-q/-H/-x)",
    )


def add_json_flag(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--json", action="store_true",
        help="print machine-readable JSON instead of plain text",
    )


def add_field_flag(parser: argparse.ArgumentParser, help_extra: str = "") -> None:
    parser.add_argument(
        "--field", dest="fields", action="append", metavar="key=value",
        help=(
            "set a structured field (repeatable), e.g. --field priority=high. "
            f"Purely optional -- ignore it and nothing changes.{help_extra}"
        ),
    )


def parse_field_args(raw: list[str] | None) -> tuple[dict, None] | tuple[None, str]:
    """Parse repeated --field key=value into a dict. Returns (None, error)
    on a malformed one."""
    fields: dict[str, str] = {}
    for item in raw or []:
        if "=" not in item:
            return None, f"invalid --field {item!r}: expected key=value"
        key, _, value = item.partition("=")
        key = key.strip()
        if not key:
            return None, f"invalid --field {item!r}: empty key"
        fields[key] = value
    return fields, None


def parse_ids_and_status(
    tokens: list[str], status_flag: str | None
) -> tuple[list[int], str] | tuple[None, str]:
    """Split move's raw positional tokens into (ids, status).

    The target status can be a trailing word (e.g. `12 13 active`) or come
    from a flag (`12 13 -x`), but not both. argparse can't express "ids
    (unbounded) then an optional trailing status" on its own -- a greedy
    nargs='+' swallows a following optional positional entirely -- so
    `move`'s ids argument is parsed as raw strings and split out here
    instead. Returns (None, error_message) on any problem.
    """
    if not tokens:
        return None, "no idea id(s) given"

    trailing = tokens[-1]
    trailing_is_status = trailing in dbutil.STATUSES

    if status_flag and trailing_is_status:
        return None, "specify the target status only once: a trailing word or a flag, not both"
    if status_flag:
        id_tokens, status = tokens, status_flag
    elif trailing_is_status:
        id_tokens, status = tokens[:-1], tokens[-1]
    elif not trailing.isdigit():
        # doesn't look like an id either -- most likely a typo'd status
        return None, f"invalid status: {trailing!r} (choose from {', '.join(dbutil.STATUSES)})"
    else:
        return None, (
            "missing target status: give it as a trailing word (e.g. 'active') "
            "or a flag (-a/-q/-H/-x/--status)"
        )

    if not id_tokens:
        return None, "no idea id(s) given"
    ids = []
    for token in id_tokens:
        if not token.isdigit():
            return None, f"invalid idea id: {token!r}"
        ids.append(int(token))
    return ids, status


def missing_ids(conn, ids: list[int]) -> list[int]:
    """Return the subset of ids that don't exist, preserving input order."""
    placeholders = ",".join("?" * len(ids))
    found = {
        row["id"]
        for row in conn.execute(f"SELECT id FROM ideas WHERE id IN ({placeholders})", ids)
    }
    return [i for i in ids if i not in found]


def status_description_lines() -> str:
    return "\n".join(
        f"  {status:<8} {STATUS_DESCRIPTIONS[status]}" for status in dbutil.STATUSES
    )


def build_epilog() -> str:
    status_lines = "\n".join(
        f"  {status:<8} {('/'.join(STATUS_FLAGS[status]) if status in STATUS_FLAGS else '(default)'):<14} "
        f"{STATUS_DESCRIPTIONS[status]}"
        for status in dbutil.STATUSES
    )
    return (
        "Statuses (flag to capture/list straight into it -- description):\n"
        f"{status_lines}\n"
        "\n"
        "Examples:\n"
        '  idea "ship the migration"        capture straight to inbox\n'
        '  idea -q "revisit nvim config"     capture straight to queued\n'
        "  idea list --status inbox         list only inbox ideas\n"
        "  idea list -q                      list only queued\n"
        "  idea move 12 active               move idea #12 to active\n"
        "  idea move 12 13 14 active         move several ideas to active at once\n"
        "  idea move 12 13 14 -x             ...or with a status flag instead\n"
        "  idea delete 12 13 14              delete several ideas at once\n"
        '  idea edit 12 "new text"          rewrite idea #12\'s text\n'
        "  idea delete 12                    delete idea #12\n"
        '  printf "one\\ntwo\\n" | idea capture --stdin -q\n'
        "                                    bulk-capture one idea per line, all -> queued\n"
        "\n"
        "Structured fields (fully optional -- ignore them and nothing changes):\n"
        '  idea "book a room" --field due=2026-10-01 --field priority=high\n'
        "  idea edit 12 --field owner=me       add/overwrite a field, text unchanged\n"
        "  idea edit 12 --unset-field owner    remove a field\n"
        "  idea show 12                        prints fields if the idea has any\n"
        "\n"
        "Daily goals (tag existing ideas as today's targets):\n"
        "  idea goal add 12 13                 tag ideas #12 and #13 as goals for today\n"
        "  idea goal list                      show today's goals and completion\n"
        "  idea goal remove 12                 untag idea #12 from today's goals\n"
        "  idea goal streak                    show the current streak and lifetime xp\n"
        "  A goal completes itself the moment that idea's status changes -- no\n"
        "  separate 'done' command.\n"
        "\n"
        "Bare `idea some text` (no subcommand) is shorthand for `idea capture some text`.\n"
        "move/delete/show accept multiple ids in one call. Run `idea <command> --help`\n"
        "for a command's full flag list, e.g. `idea capture --help`."
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="idea",
        description="Capture and manage ideas in idea-bank-v2's local SQLite database.",
        epilog=build_epilog(),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", metavar="<command>")

    capture = subparsers.add_parser(
        "capture", help="add a new idea (default when no subcommand is given)",
        description=(
            "Add a new idea (status=inbox by default). With --stdin, add one idea "
            "per non-empty line of standard input instead, for bulk capture."
        ),
    )
    capture.add_argument(
        "text", nargs="*",
        help="the idea text (quote it, or leave unquoted); omit when using --stdin",
    )
    capture.add_argument(
        "--stdin", action="store_true",
        help="bulk-capture: read one idea per line from standard input",
    )
    add_status_flags(capture, "capture straight into")
    add_field_flag(capture, " With --stdin, the same fields apply to every line.")
    add_json_flag(capture)

    list_cmd = subparsers.add_parser(
        "list", help="list ideas, optionally filtered by status",
        description="List ideas, newest-updated first.",
    )
    add_status_flags(list_cmd, "show only")
    add_json_flag(list_cmd)

    show = subparsers.add_parser(
        "show", help="show one or more ideas in full",
        description="Show one or more ideas' full text, status, and timestamps.",
    )
    show.add_argument("ids", type=int, nargs="+", metavar="id", help="idea id(s)")
    add_json_flag(show)

    move = subparsers.add_parser(
        "move", help="change the status of one or more ideas",
        description=(
            "Move one or more ideas to a different status column. Give the "
            "target status as a trailing word, or with -a/-q/-H/-x/--status."
        ),
        epilog=f"Statuses:\n{status_description_lines()}",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    move.add_argument(
        "ids", nargs="+", metavar="id",
        help="idea id(s), optionally followed by the target status as a trailing word",
    )
    add_status_flags(move, "move to", dest="status_flag")
    add_json_flag(move)

    edit = subparsers.add_parser(
        "edit", help="change an idea's text and/or its structured fields",
        description=(
            "Rewrite a single idea's text and/or set/unset its structured fields "
            "in place. Text is optional here -- omit it to only change fields."
        ),
    )
    edit.add_argument("id", type=int, help="idea id")
    edit.add_argument(
        "text", nargs="*",
        help="new text (quote it, or leave unquoted); omit to leave text unchanged",
    )
    add_field_flag(edit)
    edit.add_argument(
        "--unset-field", dest="unset_fields", action="append", metavar="key",
        help="remove a structured field (repeatable)",
    )
    add_json_flag(edit)

    delete = subparsers.add_parser(
        "delete", help="delete one or more ideas",
        description="Permanently delete one or more ideas.",
    )
    delete.add_argument("ids", type=int, nargs="+", metavar="id", help="idea id(s)")
    add_json_flag(delete)

    goal = subparsers.add_parser(
        "goal", help="daily goals: tag ideas as today's targets, track streaks",
        description=(
            "Tag existing ideas as goals for a day. A goal completes itself "
            "automatically the moment that idea's status changes -- there's "
            "no separate 'done' command."
        ),
    )
    add_json_flag(goal)  # so `idea goal` (no subcommand) can still report --json errors
    goal_sub = goal.add_subparsers(dest="goal_command", metavar="<goal-command>")

    goal_add = goal_sub.add_parser(
        "add", help="tag one or more ideas as a goal for today (or --date)",
    )
    goal_add.add_argument("ids", type=int, nargs="+", metavar="id")
    goal_add.add_argument("--date", metavar="YYYY-MM-DD", help="default: today")
    add_json_flag(goal_add)

    goal_remove = goal_sub.add_parser(
        "remove", help="untag one or more ideas from a day's goals",
    )
    goal_remove.add_argument("ids", type=int, nargs="+", metavar="id")
    goal_remove.add_argument("--date", metavar="YYYY-MM-DD", help="default: today")
    add_json_flag(goal_remove)

    goal_list = goal_sub.add_parser(
        "list", help="show a day's goals and completion",
    )
    goal_list.add_argument("--date", metavar="YYYY-MM-DD", help="default: today")
    add_json_flag(goal_list)

    goal_streak = goal_sub.add_parser(
        "streak", help="show the current daily-goal streak and lifetime xp",
    )
    add_json_flag(goal_streak)

    return parser


def fail(args, message: str) -> int:
    """Report an error in the right format and return the exit code to use."""
    if args.json:
        print(json.dumps({"error": message}))
    else:
        print(f"error: {message}", file=sys.stderr)
    return 1


def emit_idea(args, idea: dict, human_verb: str) -> None:
    if args.json:
        print(json.dumps(idea))
    else:
        print(f"{human_verb} idea #{idea['id']} [{idea['status']}]: {idea['text']}")


def emit_ideas(args, ideas: list[dict], human_verb: str) -> None:
    """Like emit_idea, but for a batch: a single result still prints as a
    single object/line (so existing single-id usage is unchanged), while
    more than one prints as a JSON array / one line each."""
    if len(ideas) == 1:
        emit_idea(args, ideas[0], human_verb)
        return
    if args.json:
        print(json.dumps(ideas))
    else:
        for idea in ideas:
            print(f"{human_verb} idea #{idea['id']} [{idea['status']}]: {idea['text']}")


def cmd_capture(args) -> int:
    status = args.status or "inbox"
    fields, err = parse_field_args(args.fields)
    if err:
        return fail(args, err)

    if args.stdin:
        if args.text:
            return fail(args, "don't pass idea text as arguments together with --stdin")
        texts = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]
        if not texts:
            return fail(args, "no non-empty lines read from stdin")
        ideas = []
        with dbutil.connection() as conn:
            for text in texts:
                idea_id = dbutil.add_idea(text, status=status, fields=fields)
                ideas.append(dbutil.get_idea(conn, idea_id))
        if args.json:
            print(json.dumps(ideas))
        else:
            for idea in ideas:
                print(f"captured idea #{idea['id']} [{idea['status']}]: {idea['text']}")
        return 0

    text = " ".join(args.text).strip()
    if not text:
        return fail(args, "idea text cannot be empty (pass text, or use --stdin)")
    idea_id = dbutil.add_idea(text, status=status, fields=fields)
    with dbutil.connection() as conn:
        emit_idea(args, dbutil.get_idea(conn, idea_id), "captured")
    return 0


def cmd_list(args) -> int:
    query = f"SELECT {dbutil.IDEA_COLUMNS} FROM ideas"
    params = ()
    if args.status:
        query += " WHERE status = ?"
        params = (args.status,)
    query += " ORDER BY updated_at DESC"

    with dbutil.connection() as conn:
        ideas = [dbutil.row_to_idea(row) for row in conn.execute(query, params)]

    if args.json:
        print(json.dumps(ideas))
        return 0

    if not ideas:
        print("no ideas found")
        return 0
    for idea in ideas:
        preview = idea["text"] if len(idea["text"]) <= 70 else idea["text"][:67] + "..."
        marker = "*" if idea["fields"] else " "
        print(f"#{idea['id']:<4} [{idea['status']:<7}]{marker}{preview}  ({idea['updated_at']})")
    if any(idea["fields"] for idea in ideas):
        print("\n* has structured fields -- see `idea show <id>`")
    return 0


def cmd_show(args) -> int:
    with dbutil.connection() as conn:
        missing = missing_ids(conn, args.ids)
        if missing:
            return fail(args, f"no idea(s) with id(s): {', '.join(map(str, missing))}")
        ideas = [dbutil.get_idea(conn, idea_id) for idea_id in args.ids]

    if args.json:
        print(json.dumps(ideas[0] if len(ideas) == 1 else ideas))
        return 0
    for i, idea in enumerate(ideas):
        if i > 0:
            print()
        print(f"#{idea['id']} [{idea['status']}]")
        print(idea["text"])
        print(f"created: {idea['created_at']}")
        print(f"updated: {idea['updated_at']}")
        if idea["notes"]:
            print(f"notes: {idea['notes']}")
        if idea["fields"]:
            print("fields:")
            for key, value in idea["fields"].items():
                print(f"  {key}: {value}")
    return 0


def cmd_move(args) -> int:
    ids, status = parse_ids_and_status(args.ids, args.status_flag)
    if ids is None:
        return fail(args, status)  # status holds the error message here

    with dbutil.connection() as conn:
        missing = missing_ids(conn, ids)
        if missing:
            return fail(args, f"no idea(s) with id(s): {', '.join(map(str, missing))}")
        now = dbutil.now_str()
        conn.executemany(
            "UPDATE ideas SET status = ?, updated_at = ? WHERE id = ?",
            [(status, now, idea_id) for idea_id in ids],
        )
        conn.commit()
        ideas = [dbutil.get_idea(conn, idea_id) for idea_id in ids]
    emit_ideas(args, ideas, "moved")
    return 0


def cmd_edit(args) -> int:
    text = " ".join(args.text).strip() if args.text else None
    field_updates, err = parse_field_args(args.fields)
    if err:
        return fail(args, err)
    unset_fields = args.unset_fields or []

    if text is None and not field_updates and not unset_fields:
        return fail(args, "nothing to change: pass new text, --field, and/or --unset-field")

    with dbutil.connection() as conn:
        idea = dbutil.get_idea(conn, args.id)
        if idea is None:
            return fail(args, f"no idea with id {args.id}")

        set_clauses, values = ["updated_at = ?"], [dbutil.now_str()]

        if text is not None:
            if not text:
                return fail(args, "idea text cannot be empty")
            set_clauses.append("text = ?")
            values.append(text)

        if field_updates or unset_fields:
            merged = {**idea["fields"], **field_updates}
            for key in unset_fields:
                merged.pop(key, None)
            set_clauses.append("fields = ?")
            values.append(dbutil.encode_fields(merged))

        values.append(args.id)
        conn.execute(f"UPDATE ideas SET {', '.join(set_clauses)} WHERE id = ?", values)
        conn.commit()
        emit_idea(args, dbutil.get_idea(conn, args.id), "edited")
    return 0


def cmd_delete(args) -> int:
    with dbutil.connection() as conn:
        missing = missing_ids(conn, args.ids)
        if missing:
            return fail(args, f"no idea(s) with id(s): {', '.join(map(str, missing))}")
        for idea_id in args.ids:
            dbutil.remove_goals_for_idea(conn, idea_id)
        conn.executemany("DELETE FROM ideas WHERE id = ?", [(i,) for i in args.ids])
        conn.commit()

    if args.json:
        results = [{"deleted": True, "id": i} for i in args.ids]
        print(json.dumps(results[0] if len(results) == 1 else results))
    else:
        for idea_id in args.ids:
            print(f"deleted idea #{idea_id}")
    return 0


def cmd_goal_add(args) -> int:
    date = args.date or dbutil.today_str()
    with dbutil.connection() as conn:
        missing = missing_ids(conn, args.ids)
        if missing:
            return fail(args, f"no idea(s) with id(s): {', '.join(map(str, missing))}")
        goals = [dbutil.add_goal(conn, idea_id, date) for idea_id in args.ids]

    if args.json:
        print(json.dumps(goals[0] if len(goals) == 1 else goals))
    else:
        for g in goals:
            print(f"goal set for {g['date']}: idea #{g['idea_id']} [{g['status_at_tag']}] {g['idea_text_snapshot']}")
    return 0


def cmd_goal_remove(args) -> int:
    date = args.date or dbutil.today_str()
    with dbutil.connection() as conn:
        removed = [idea_id for idea_id in args.ids if dbutil.remove_goal(conn, idea_id, date)]

    if not removed:
        return fail(args, f"no goal(s) for {date} matching those id(s)")
    if args.json:
        print(json.dumps({"date": date, "removed": removed}))
    else:
        for idea_id in removed:
            print(f"removed goal for {date}: idea #{idea_id}")
    return 0


def cmd_goal_list(args) -> int:
    date = args.date or dbutil.today_str()
    with dbutil.connection() as conn:
        goals = dbutil.goals_for_date(conn, date)

    if args.json:
        print(json.dumps({"date": date, "goals": goals}))
        return 0
    if not goals:
        print(f"no goals set for {date}")
        return 0
    done = sum(1 for g in goals if g["completed_at"])
    print(f"{date}: {done}/{len(goals)} goals complete")
    for g in goals:
        mark = "x" if g["completed_at"] else " "
        print(f"  [{mark}] idea #{g['idea_id']}: {g['idea_text_snapshot']}")
    return 0


def cmd_goal_streak(args) -> int:
    with dbutil.connection() as conn:
        info = dbutil.compute_streak(conn)
        info["xp"] = dbutil.total_xp(conn)

    if args.json:
        print(json.dumps(info))
        return 0
    print(f"streak: {info['streak']} day(s)  (longest: {info['longest']})  xp: {info['xp']}")
    if info["today_total"]:
        print(f"today: {info['today_done']}/{info['today_total']} goals complete")
    if not info["today_complete"]:
        print("today isn't locked in yet -- finish today's goals to extend the streak")
    return 0


GOAL_COMMANDS = {
    "add": cmd_goal_add,
    "remove": cmd_goal_remove,
    "list": cmd_goal_list,
    "streak": cmd_goal_streak,
}


def cmd_goal(args) -> int:
    if args.goal_command is None:
        return fail(args, "missing goal subcommand: add/remove/list/streak (see `idea goal --help`)")
    return GOAL_COMMANDS[args.goal_command](args)


COMMANDS = {
    "capture": cmd_capture,
    "list": cmd_list,
    "show": cmd_show,
    "move": cmd_move,
    "edit": cmd_edit,
    "delete": cmd_delete,
    "goal": cmd_goal,
}


def main() -> int:
    argv = sys.argv[1:]
    # bare `idea some text` (no recognized subcommand) is shorthand for
    # `idea capture some text`, matching the old shell function's usage.
    if argv and argv[0] not in COMMANDS and argv[0] not in ("-h", "--help"):
        argv = ["capture", *argv]
    elif not argv:
        argv = ["--help"]

    parser = build_parser()
    args = parser.parse_args(argv)
    return COMMANDS[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
